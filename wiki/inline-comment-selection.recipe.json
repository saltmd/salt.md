{
  "id": "inline-comment-selection",
  "page": "comments-and-notes.md",
  "caption": "Selecting text opens a comment draft with the original quote.",
  "shows": [
    "web/src/components/Editor.tsx",
    "web/src/components/CommentsPanel.tsx",
    "web/src/components/InlineComments.tsx",
    "web/src/styles.css",
    "web/src/theme.css"
  ],
  "steps": [
    {
      "goto": "/"
    },
    {
      "waitFor": ".sidebar"
    },
    {
      "click": ".bn-editor"
    },
    {
      "press": "ControlOrMeta+Home"
    },
    {
      "press": "Shift+End"
    },
    {
      "click": "[aria-label=\"Comment on selected text\"]"
    },
    {
      "fill": [
        ".cp-compose textarea",
        "Can we make this description more specific?"
      ]
    },
    {
      "wait": 600
    }
  ]
}
